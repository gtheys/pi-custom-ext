{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@mariozechner/pi-coding-agent": ["./node_modules/@earendil-works/pi-coding-agent"],
      "@mariozechner/pi-tui": ["./node_modules/@earendil-works/pi-tui"],
      "@gtheys/pi-interactive-subagents": ["./packages/pi-test-runner/types/pi-interactive-subagents.d.ts"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": [
    "packages/pi-sem/node_modules/**",
    "packages/pi-interactive-subagents/**/*.ts",
    "node_modules/**"
  ]
}
